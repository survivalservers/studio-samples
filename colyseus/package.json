{
  "name": "colyseus-server-sample",
  "version": "1.0.0",
  "private": true,
  "description": "A Colyseus (Node.js, TypeScript) game server on the platform: ports from GS_* variables, ready, players, the match and the shutdown notice on the local API.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@colyseus/core": "0.18.10",
    "@colyseus/schema": "5.0.43",
    "@colyseus/ws-transport": "0.18.4",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.9",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
