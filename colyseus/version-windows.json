{
  "name": "1.0.0",
  "build": "BUILD_ID",
  "size": {
    "cpu": 1,
    "memory_gb": 1
  },
  "launch": {
    "executable": "node.exe",
    "args": [
      "server.cjs"
    ],
    "ports": [
      {
        "name": "game",
        "protocol": "tcp"
      }
    ],
    "ready_check": {
      "type": "local_api"
    },
    "stop": {
      "method": "ctrl_break",
      "shutdown_time": "10s"
    }
  },
  "restart": {
    "policy": "never"
  },
  "max_duration": "2h",
  "regions": [
    "*"
  ]
}
