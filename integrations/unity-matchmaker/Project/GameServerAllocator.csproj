<Project Sdk="Microsoft.NET.Sdk">

  <!-- A Unity Cloud Code module: the allocator Unity Matchmaker calls to start a game server for each match. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>GameServerAllocatorModule</RootNamespace>
    <AssemblyName>GameServerAllocator</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Com.Unity.Services.CloudCode.Apis" Version="0.0.27" />
    <PackageReference Include="Com.Unity.Services.CloudCode.Core" Version="0.0.7" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GameServerAllocator.Tests" />
  </ItemGroup>

</Project>
